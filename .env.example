# ============================================================
# Agent Core 配置文件
# ============================================================

# LLM 配置
# 可选值: openai, claude, ollama
LLM_PROVIDER=claude
# OpenAI: gpt-4-turbo-preview, gpt-3.5-turbo
# Claude: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# Ollama: llama2, mistral, etc.
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.7

# API代理配置（可选）
# 如果使用第三方API代理，填写代理地址（去掉末尾的斜杠）
# ANTHROPIC_API_BASE=https://claude.micu.wiki
# OPENAI_API_BASE=https://your-openai-proxy.com

# API Keys
# OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# 后端服务配置
# ============================================================

# 默认后端URL（无人机后端）
BACKEND_URL=http://localhost:3001

# 多后端配置（JSON格式，可选）
# 格式: {"name": {"url": "...", "description": "...", "timeout": 10.0}}
# 示例:
# BACKENDS_CONFIG={"drone": {"url": "http://localhost:3001", "description": "无人机后端"}, "smart_home": {"url": "http://localhost:4000", "description": "智能家居后端"}}

# ============================================================
# 服务器配置
# ============================================================

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ============================================================
# 数据库和缓存（可选）
# ============================================================

# PostgreSQL数据库
# DATABASE_URL=postgresql://agent:agent123@localhost:5432/agent_db

# Redis缓存
# REDIS_URL=redis://localhost:6379/0

# ============================================================
# 安全配置
# ============================================================

# API访问密钥（可选，用于客户端认证）
# API_KEY=your_api_key_for_client_authentication

# CORS允许的来源（逗号分隔，默认允许所有）
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,*

# ============================================================
# 功能开关
# ============================================================

# 工具执行前是否需要确认
ENABLE_TOOL_CONFIRMATION=false

# 启用流式响应
ENABLE_STREAMING=true

# 对话历史最大条数
MAX_CONVERSATION_HISTORY=50
