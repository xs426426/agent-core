# 生产环境配置模板
# 复制此文件为 .env.prod 并填写实际值

# === LLM配置 ===
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7

# === API密钥（必需）===
# 至少配置一个
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# === 第三方API代理（可选）===
# ANTHROPIC_API_BASE=https://your-proxy-url
# OPENAI_API_BASE=https://your-proxy-url

# === 无人机后端 ===
BACKEND_URL=http://your-drone-backend:3001

# === 服务配置 ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# === 安全配置（推荐）===
# 设置一个随机字符串作为API认证密钥
# API_KEY=your-random-secret-key-here

# 允许的跨域来源（逗号分隔）
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://another-domain.com

# === 功能开关 ===
ENABLE_TOOL_CONFIRMATION=false
ENABLE_STREAMING=true
MAX_CONVERSATION_HISTORY=50

# === 数据库（可选）===
# 如需持久化对话历史
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# === Redis缓存（可选）===
# 如需会话缓存
# REDIS_URL=redis://host:6379/0
